# JSERVICE Enterprise ERP Environment Configuration
APP_NAME="سامانه جامع خدمات پس از فروش و گارانتی جی سرویس"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.ir
APP_KEY=base64:7f9b8c2d1e4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c
APP_LOCALE=fa
APP_TIMEZONE=Asia/Tehran

# Database Credentials
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_jservice
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=YourStrongDatabasePassword123#
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session & Security
SESSION_LIFETIME=1800
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Strict
BCRYPT_ROUNDS=12

# License System API
LICENSE_KEY=JS-ENT-2024-9981-FA-PRO
LICENSE_SERVER_URL=https://license.jservice.ir/api/v1
LICENSE_VERIFY_INTERVAL=86400
LICENSE_GRACE_PERIOD_DAYS=7

# SMS Gateway (Kavenegar / FarazSMS / MeliPayak)
SMS_PROVIDER=kavenegar
SMS_API_KEY=your_sms_gateway_api_key_here
SMS_LINE_NUMBER=10008888
SMS_DEFAULT_TEMPLATE=jservice_status_update

# Mail Settings
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourdomain.ir
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.ir
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls
