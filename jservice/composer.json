  "require": {
    "php": ">=8.1.0",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-curl": "*",
    "firebase/php-jwt": "^6.10.0",
    "phpmailer/phpmailer": "^6.9.1",
    "endroid/qr-code": "^5.0.0",
    "dompdf/dompdf": "^3.0.0",
    "phpoffice/phpspreadsheet": "^2.1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Core/Helper.php"
    ]
